// Cloudflare Workers config: serves the built static site in dist/ (no server code).
// The name must match the Worker/project name in the Cloudflare dashboard.
{
  "name": "bibliofeed",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist"
  },
  // Serve the site on *.workers.dev, and give every non-production build its
  // own preview link (Cloudflare posts it on the pull request).
  "workers_dev": true,
  "preview_urls": true
}
