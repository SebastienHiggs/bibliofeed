// Cloudflare Workers config: serves the built static site in dist/ (no server code).
// The name must match the Worker/project name in the Cloudflare dashboard.
{
  "name": "bibliofeed",
  "compatibility_date": "2025-09-01",
  // Wrangler runs this before deploying, so the build is defined here in the
  // repo rather than typed into Cloudflare's settings. Leave the dashboard's
  // build command empty (or set it to `npm run build`; running twice is harmless).
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist"
  },
  // Serve the site on *.workers.dev, and give every non-production build its
  // own preview link (Cloudflare posts it on the pull request).
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, the command Cloudflare's preview builds run.
  // Empty means previews use the same settings as above.
  "previews": {}
}
